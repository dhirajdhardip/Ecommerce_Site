# Production & Local Environment Variables
SECRET_KEY=django-insecure-change-this-in-production-environment-key-902183!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com,https://*.railway.app

# Database Configuration (PostgreSQL on Render/Railway)
# Format: postgres://username:password@hostname:port/database_name
DATABASE_URL=postgres://techstore_user:techstore_pass@localhost:5432/techstore_db

# Cloudinary Configuration (Media File Storage for Production)
# Sign up free: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
